<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>CNVMONT Web3D Skinning Blending</title>
  <style>
    .grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 0px;
    }

    .grid-item {
    background-color: #ffffff;
    color: white;
    padding: 0px;
    text-align: center;
    font-size: 12px;
    border-radius: 0px;
    }
  </style>
</head>
<body>
  <div>
    <h1>Test Web3D server: Skinning Blending</h1>
    <div class="grid-container">
      <% for (let i = 0; i < skinningList.length; i++) { %>
        <div class="grid-item">
            <iframe src=<%= skinningList[i] %>/false width="300" height = "200" title=<%= skinningList[i] %> frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                style="overflow: hidden;" scrolling="no"
                allowfullscreen></iframe><br>
            <a href=<%= skinningList[i] %>/true target="_blank"><%= skinningList[i] %></a>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>