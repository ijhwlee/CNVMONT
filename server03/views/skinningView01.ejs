<body>
  <div id="container">
    <div id="loader_glb" style="position:absolute; top: 50%; left: 10%; width:300px; background:#ccc;">
      <div id="progress_glb" style="text-align: center; width:0%; height:24px; background:#76c7c0;">
        <span id="percent_glb" style="margin-top: 2px; font-family: sans-serif; font-size: 12px; font-weight: bold">0%</span>
      </div>
    </div>
  </div>
</body>
